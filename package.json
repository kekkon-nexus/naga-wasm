{
	"private": true,
	"workspaces": [
		"npm"
	],
	"type": "module",
	"scripts": {
		"prepare": "lefthook install",
		"build": "bun npm/scripts/build.ts",
		"clean": "rm -rf npm/dist npm/*.tsbuildinfo npm/LICENSE-* npm/README.md",
		"pack": "bun pm pack --cwd npm --destination ..",
		"bump": "bun scripts/bump.ts",
		"check": "lefthook run check",
		"fix": "lefthook run fix",
		"test": "lefthook run test"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@kekkon-nexus/config": "^3.3.1",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"lefthook": "^2.1.17",
		"naga-wasm": "workspace:*",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"tombi": "^1.7.2",
		"typescript": "^7.0.2",
		"v8r": "^6.1.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	}
}
