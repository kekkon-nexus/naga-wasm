{
	"name": "naga-wasm",
	"version": "0.0.0",
	"description": "naga shader translator (wgpu) compiled to WebAssembly",
	"keywords": [
		"glsl",
		"hlsl",
		"msl",
		"naga",
		"shader",
		"spirv",
		"wasm",
		"webassembly",
		"wgpu",
		"wgsl"
	],
	"license": "MIT OR Apache-2.0",
	"contributors": [
		"Ryan Suhartanto <suhartanto@kekkon.nexus>"
	],
	"repository": "kekkon-nexus/naga-wasm",
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"node": "./dist/node.js",
			"default": "./dist/index.js"
		},
		"./naga_bg.wasm": "./dist/wasm/naga_bg.wasm"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.12"
	}
}
